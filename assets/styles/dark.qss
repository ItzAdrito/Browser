/* Modern Dark Theme for PyBrowser */
QMainWindow {
    background-color: #1e1e24;
}

QWidget {
    color: #e0e0e6;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    font-size: 13px;
}

QToolBar {
    background: #18181c;
    border: none;
    border-bottom: 1px solid #2b2b36;
    padding: 6px 10px;
    spacing: 8px;
}

QToolButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 6px;
    color: #cbd5e1;
}

QToolButton:hover {
    background-color: #2b2b38;
    border: 1px solid #3b3b4a;
}

QToolButton:pressed {
    background-color: #38384a;
}

QToolButton:disabled {
    color: #555566;
}

/* Omnibar Address Bar */
QLineEdit#Omnibar {
    background-color: #262630;
    color: #f1f5f9;
    border: 1px solid #3d3d4e;
    border-radius: 8px;
    padding: 7px 12px;
    font-size: 13px;
    selection-background-color: #3b82f6;
    selection-color: #ffffff;
}

QLineEdit#Omnibar:focus {
    border: 1px solid #3b82f6;
    background-color: #2c2c38;
}

/* Tab Widget Styling */
QTabWidget::pane {
    border: none;
    background-color: #1e1e24;
}

QTabBar::tab {
    background: #18181c;
    color: #94a3b8;
    padding: 8px 18px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom: none;
    min-width: 140px;
    max-width: 240px;
    margin-right: 3px;
}

QTabBar::tab:selected {
    background: #262630;
    color: #ffffff;
    font-weight: 600;
}

QTabBar::tab:hover:!selected {
    background: #202027;
    color: #e2e8f0;
}

QTabBar::close-button {
    image: url(assets/icons/close.svg);
    subcontrol-position: right;
    margin-right: 4px;
}

QTabBar::close-button:hover {
    background: #3f3f50;
    border-radius: 4px;
}

/* Status Bar & Progress Bar */
QStatusBar {
    background-color: #18181c;
    color: #64748b;
    border-top: 1px solid #2b2b36;
    font-size: 12px;
    padding: 2px 8px;
}

QProgressBar {
    border: none;
    height: 3px;
    background-color: transparent;
    text-align: center;
}

QProgressBar::chunk {
    background-color: #3b82f6;
}

/* Dialogs & Menus */
QDialog {
    background-color: #1e1e24;
    color: #e0e0e6;
}

QTableWidget {
    background-color: #262630;
    border: 1px solid #3d3d4e;
    border-radius: 6px;
    gridline-color: #353545;
    color: #f1f5f9;
}

QTableWidget::item:selected {
    background-color: #3b82f6;
    color: #ffffff;
}

QHeaderView::section {
    background-color: #1a1a20;
    color: #94a3b8;
    border: none;
    border-bottom: 1px solid #3d3d4e;
    padding: 6px;
    font-weight: 600;
}

QPushButton {
    background-color: #3b82f6;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 7px 16px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #2563eb;
}

QPushButton:pressed {
    background-color: #1d4ed8;
}

QPushButton#SecondaryButton {
    background-color: #2b2b38;
    color: #e0e0e6;
    border: 1px solid #3b3b4a;
}

QPushButton#SecondaryButton:hover {
    background-color: #38384a;
}

QMenu {
    background-color: #262630;
    border: 1px solid #3b3b4a;
    border-radius: 6px;
    padding: 4px;
}

QMenu::item {
    padding: 6px 24px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #3b82f6;
    color: #ffffff;
}
